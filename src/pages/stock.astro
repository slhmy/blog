---
import BaseHead from '../components/BaseHead.astro';
import BlogLetterGlitch from '../components/BlogLetterGlitch.jsx';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import StockChart from '../components/StockChart.jsx';
import { stockEntries } from '../data/stock';

const chartData = stockEntries.map((entry) => ({ ...entry }));
const total = stockEntries.reduce((sum, entry) => sum + entry.value, 0);
const latest = stockEntries.at(-1);
const positiveDays = stockEntries.filter((entry) => entry.value > 0).length;
const winRate = stockEntries.length ? (positiveDays / stockEntries.length) * 100 : 0;
const bestDay = stockEntries.reduce(
	(best, entry) => (entry.value > best.value ? entry : best),
	stockEntries[0],
);
const recentEntries = stockEntries.slice(-5).reverse();
const latestPeriod = latest
	? new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short' }).format(
			new Date(`${latest.date}T00:00:00`),
		)
	: 'No entries';

const numberFormatter = new Intl.NumberFormat('en-US', { maximumFractionDigits: 2 });
const formatValue = (value: number) => `${value > 0 ? '+' : ''}${numberFormatter.format(value)}`;
const formatDate = (date: string) =>
	new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' }).format(
		new Date(`${date}T00:00:00`),
	);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Stock Ledger · slhmy's Blog"
			description="A private daily performance log without holdings, positions, or currency units."
		/>
		<style is:global>
			body.stock-page {
				--liquid-bg:
					radial-gradient(circle at 16% 14%, rgba(94, 121, 255, 0.2), transparent 34%),
					radial-gradient(circle at 86% 22%, rgba(119, 225, 184, 0.17), transparent 30%),
					radial-gradient(circle at 52% 84%, rgba(214, 182, 216, 0.18), transparent 42%),
					#f7f9ff;
				--liquid-filter: saturate(1.02) contrast(1.02) brightness(1.04);
				--liquid-chrome-bg: rgba(var(--bg), 0.76);
				--stock-panel: rgba(var(--bg), 0.74);
				--stock-panel-soft: rgba(var(--bg), 0.48);
				--stock-border: rgba(var(--gray-light), 0.9);
				--stock-shadow: 0 24px 80px rgba(var(--gray), 0.16);
				display: block;
				background: rgb(var(--bg));
				min-height: 100vh;
				min-height: 100dvh;
			}
			.stock-layout {
				display: flex;
				flex-direction: column;
				min-height: 100vh;
				min-height: 100dvh;
			}
			:root[data-theme='dark'] body.stock-page {
				--liquid-bg:
					radial-gradient(circle at 18% 18%, rgba(82, 39, 255, 0.24), transparent 34%),
					radial-gradient(circle at 86% 20%, rgba(61, 196, 146, 0.18), transparent 30%),
					radial-gradient(circle at 52% 86%, rgba(255, 159, 252, 0.16), transparent 40%),
					#070711;
				--liquid-filter: saturate(1.22) contrast(1.07);
				--liquid-chrome-bg: rgba(var(--bg), 0.64);
				--stock-panel: rgba(var(--bg), 0.58);
				--stock-panel-soft: rgba(var(--bg), 0.35);
				--stock-border: rgba(var(--gray-dark), 0.15);
				--stock-shadow: 0 24px 90px rgba(0, 0, 0, 0.36);
			}
			@media (prefers-color-scheme: dark) {
				:root[data-theme='auto'] body.stock-page {
					--liquid-bg:
						radial-gradient(circle at 18% 18%, rgba(82, 39, 255, 0.24), transparent 34%),
						radial-gradient(circle at 86% 20%, rgba(61, 196, 146, 0.18), transparent 30%),
						radial-gradient(circle at 52% 86%, rgba(255, 159, 252, 0.16), transparent 40%),
						#070711;
					--liquid-filter: saturate(1.22) contrast(1.07);
					--liquid-chrome-bg: rgba(var(--bg), 0.64);
					--stock-panel: rgba(var(--bg), 0.58);
					--stock-panel-soft: rgba(var(--bg), 0.35);
					--stock-border: rgba(var(--gray-dark), 0.15);
					--stock-shadow: 0 24px 90px rgba(0, 0, 0, 0.36);
				}
			}
			body.stock-page .letter-glitch-container {
				position: fixed;
				inset: 0;
				z-index: 0;
				width: 100vw;
				height: 100vh;
				pointer-events: none;
				background: var(--liquid-bg);
				filter: var(--liquid-filter);
			}
			body.stock-page header,
			body.stock-page footer {
				position: relative;
				z-index: 10;
				background: var(--liquid-chrome-bg);
				backdrop-filter: blur(18px);
			}
			body.stock-page main {
				position: relative;
				z-index: 1;
				flex: 1 0 auto;
				width: 960px;
				box-sizing: border-box;
				padding-top: 2.4em;
				padding-bottom: 2.4em;
			}
			body.stock-page footer {
				flex: 0 0 auto;
				width: 100%;
				box-sizing: border-box;
				margin-top: auto;
			}
			body.stock-page > [data-pagefind-announcer] {
				position: fixed !important;
				width: 1px !important;
				height: 1px !important;
				padding: 0 !important;
				margin: -1px !important;
				overflow: hidden !important;
				clip: rect(0 0 0 0) !important;
				clip-path: inset(50%) !important;
				white-space: nowrap !important;
				border: 0 !important;
			}
			.stock-panel {
				border: 1px solid var(--stock-border);
				border-radius: 18px;
				background: var(--stock-panel);
				box-shadow: var(--stock-shadow);
				backdrop-filter: blur(24px);
			}
			.metrics-grid {
				display: grid;
				grid-template-columns: 1.4fr repeat(3, 1fr);
				border-bottom: 1px solid var(--stock-border);
			}
			.metric {
				min-width: 0;
				padding: 1.25em 1.35em;
			}
			.metric + .metric {
				border-left: 1px solid var(--stock-border);
			}
			.metric-label {
				display: block;
				margin-bottom: 0.2em;
				color: rgb(var(--gray));
				font-size: 0.68em;
				font-weight: 700;
				letter-spacing: 0.04em;
			}
			.metric-value {
				display: block;
				color: rgb(var(--black));
				font-size: clamp(1.15em, 3.2vw, 1.72em);
				font-weight: 700;
				line-height: 1.15;
				font-variant-numeric: tabular-nums;
				letter-spacing: -0.025em;
			}
			.metric-value.positive { color: #168b68; }
			:root[data-theme='dark'] .metric-value.positive { color: #70e1b5; }
			@media (prefers-color-scheme: dark) {
				:root[data-theme='auto'] .metric-value.positive { color: #70e1b5; }
			}
			.chart-section {
				padding: 1.3em 1.35em 1.4em;
			}
			.chart-heading {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 1em;
				margin-bottom: 0.65em;
			}
			.chart-heading h2 {
				margin: 0;
				font-size: 1.05em;
			}
			.chart-heading p {
				margin: 0.3em 0 0;
				color: rgb(var(--gray));
				font-size: 0.72em;
			}
			.stock-chart-shell {
				position: relative;
				width: 100%;
				min-height: 390px;
			}
			.stock-chart-shell canvas {
				display: block;
				max-width: 100%;
				touch-action: pan-y;
			}
			.stock-chart-legend {
				display: flex;
				flex-wrap: wrap;
				gap: 0.65em 1.1em;
				margin: 0.2em 0 -0.4em;
				color: rgb(var(--gray));
				font-size: 0.64em;
			}
			.stock-chart-legend span {
				display: inline-flex;
				align-items: center;
				gap: 0.42em;
			}
			.stock-chart-legend i { display: inline-block; }
			.legend-bar {
				width: 0.55em;
				height: 0.78em;
				border-radius: 0.16em;
			}
			.legend-bar.positive { background: #42c896; }
			.legend-bar.negative { background: #e96079; }
			.legend-line {
				width: 1.25em;
				height: 2px;
				border-radius: 999px;
				background: #6b83ff;
			}
			.history-card {
				margin-top: 1em;
				padding: 1.25em 1.35em;
			}
			.card-heading {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1em;
				margin-bottom: 0.75em;
			}
			.card-heading h2,
			.history-card h2 {
				margin: 0;
				font-size: 0.92em;
			}
			.card-heading span {
				color: rgb(var(--gray));
				font-size: 0.64em;
			}
			.history-list {
				display: grid;
				grid-template-columns: repeat(5, minmax(0, 1fr));
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.history-row {
				display: flex;
				align-items: flex-start;
				flex-direction: column;
				gap: 0.12em;
				padding: 0.65em 0.9em;
				border-left: 1px solid var(--stock-border);
				font-size: 0.8em;
			}
			.history-row:first-child {
				padding-left: 0;
				border-left: 0;
			}
			.history-date { color: rgb(var(--gray)); }
			.history-value {
				font-weight: 700;
				font-variant-numeric: tabular-nums;
			}
			.history-value.positive { color: #168b68; }
			.history-value.negative { color: #d84a64; }
			:root[data-theme='dark'] .history-value.positive { color: #70e1b5; }
			:root[data-theme='dark'] .history-value.negative { color: #ff7890; }
			@media (prefers-color-scheme: dark) {
				:root[data-theme='auto'] .history-value.positive { color: #70e1b5; }
				:root[data-theme='auto'] .history-value.negative { color: #ff7890; }
			}
			@media (max-width: 720px) {
				body.stock-page main {
					width: calc(100% - 1rem);
					padding-top: 1rem;
					padding-bottom: 2rem;
				}
				.stock-panel { border-radius: 14px; }
				.metrics-grid {
					grid-template-columns: repeat(2, 1fr);
				}
				.metric:nth-child(3) { border-left: 0; }
				.metric:nth-child(n + 3) { border-top: 1px solid var(--stock-border); }
				.history-list {
					display: flex;
					overflow-x: auto;
					margin-inline: -1.35em;
					padding-inline: 1.35em;
					scroll-snap-type: x proximity;
					scrollbar-width: thin;
				}
				.history-row {
					flex: 0 0 7em;
					scroll-snap-align: start;
				}
				.stock-chart-shell { min-height: 330px; }
				.chart-heading p { max-width: 42rem; line-height: 1.45; }
			}
			@media (max-width: 430px) {
				.metric { padding: 0.9rem; }
				.metric-label { font-size: 0.64em; line-height: 1.3; }
				.metric-value { font-size: 1.2em; }
				.chart-section,
				.history-card { padding: 0.9rem; }
				.history-list { margin-inline: -0.9rem; padding-inline: 0.9rem; }
				.stock-chart-shell { min-height: 300px; }
			}
		</style>
	</head>
	<body class="stock-page">
		<BlogLetterGlitch client:load />
		<div class="stock-layout">
			<Header />
			<main>
			<section class="stock-panel" aria-labelledby="chart-title">
				<div class="metrics-grid">
					<div class="metric">
						<span class="metric-label">Cumulative P&amp;L</span>
						<strong class:list={['metric-value', { positive: total >= 0 }]}>{formatValue(total)}</strong>
					</div>
					<div class="metric">
						<span class="metric-label">Latest day</span>
						<strong class:list={['metric-value', { positive: (latest?.value ?? 0) >= 0 }]}>
							{latest ? formatValue(latest.value) : '—'}
						</strong>
					</div>
					<div class="metric">
						<span class="metric-label">Profitable days</span>
						<strong class="metric-value">{winRate.toFixed(1)}%</strong>
					</div>
					<div class="metric">
						<span class="metric-label">Best day</span>
						<strong class="metric-value positive">{formatValue(bestDay.value)}</strong>
					</div>
				</div>
				<div class="chart-section">
					<div class="chart-heading">
						<div>
							<h2 id="chart-title">Daily P&amp;L · {latestPeriod}</h2>
							<p>Bars show each day; the line tracks cumulative performance. Hover for details.</p>
						</div>
					</div>
					<StockChart client:load entries={chartData} />
				</div>
			</section>

			<section class="stock-panel history-card" aria-labelledby="history-title">
				<div class="card-heading">
					<h2 id="history-title">Recent entries</h2>
					<span>{stockEntries.length} entries</span>
				</div>
				<ul class="history-list">
					{recentEntries.map((entry) => (
						<li class="history-row">
							<time class="history-date" datetime={entry.date}>{formatDate(entry.date)}</time>
							<span class:list={['history-value', entry.value >= 0 ? 'positive' : 'negative']}>
								{formatValue(entry.value)}
							</span>
						</li>
					))}
				</ul>
			</section>
			</main>
			<Footer />
		</div>
	</body>
</html>
